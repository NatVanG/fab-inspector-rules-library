{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "name": "Notebook Spark Session Must Enable V-Order for Gold Workloads",
  "description": "Returns notebook file name when code disables v-order settings.",
  "rules": [
    {
      "id": "NOTEBOOK_VORDER_MUST_NOT_BE_DISABLED",
      "tags": ["notebook", "performance", "lakehouse"],
      "name": "Notebook Spark Session Must Enable V-Order for Gold Workloads",
      "description": "Returns notebook file name when code disables v-order settings. WARNING: This rule was AI-generated and tested only against sample fixtures. Review before production use.",
      "itemType": "Notebook",
      "part": "notebook-content.py",
      "test": [
        {
          "let": [
            {
              "pathInfo": { "partinfo": "" },
              "matches": {
                "filetextsearchcount": [
                  {
                    "query": [
                      { "partinfo": "" },
                      { "var": "filesystempath" }
                    ]
                  },
                  "(?i)(spark\\.sql\\.parquet\\.vorder\\.default\\s*['\"]?[,=]\\s*['\"]?false|set\\s+spark\\.sql\\.parquet\\.vorder\\.default\\s*=\\s*false|vorder\\.enabled\\s*=\\s*false)"
                ]
              }
            },
            {
              "if": [
                { ">": [ { "var": "matches" }, 0 ] },
                [ { "var": "pathInfo.filesystemname" } ],
                []
              ]
            }
          ]
        },
        []
      ]
    }
  ]
}
