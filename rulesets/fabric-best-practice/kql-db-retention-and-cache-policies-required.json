{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "KQLDB_RETENTION_AND_CACHE_POLICIES_REQUIRED",
      "name": "KQL Database Must Define Retention and Cache Policies",
      "description": "Returns markers for missing retention/cache policy properties in database definition. WARNING: This rule was AI-generated and tested only against sample fixtures. Review before production use.",
      "itemType": "KQLDatabase",
      "part": "DatabaseProperties.json",
      "test": [
        {
          "merge": [
            {
              "if": [
                {
                  "isnullorempty": [
                    {
                      "coalesce": [
                        { "var": "databaseRetention" },
                        { "var": "retentionPolicy" }
                      ]
                    }
                  ]
                },
                ["databaseRetention"],
                []
              ]
            },
            {
              "if": [
                {
                  "isnullorempty": [
                    {
                      "coalesce": [
                        { "var": "databaseCache" },
                        { "var": "cachePolicy" }
                      ]
                    }
                  ]
                },
                ["databaseCache"],
                []
              ]
            }
          ]
        },
        []
      ]
    }
  ]
}
