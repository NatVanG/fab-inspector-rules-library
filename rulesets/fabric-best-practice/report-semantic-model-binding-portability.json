{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "REPORT_SEMANTIC_MODEL_BINDING_PORTABILITY",
      "tags": ["reporting", "semantic-model", "portability"],
      "name": "Report Semantic Model Binding Portability",
      "description": "Returns a marker when the report binding uses datasetReference.byConnection instead of datasetReference.byPath. WARNING: This rule was AI-generated and tested only against sample fixtures. Review before production use.",
      "itemType": "Report",
      "part": "definition.pbir",
      "test": [
        {
          "if": [
            {
              "!": [
                {
                  "isnullorempty": [
                    {
                      "var": "datasetReference.byPath.path"
                    }
                  ]
                }
              ]
            },
            [],
            [
              {
                "torecord": [
                  "datasetReferenceMode",
                  "byConnection"
                ]
              }
            ]
          ]
        },
        []
      ]
    }
  ]
}