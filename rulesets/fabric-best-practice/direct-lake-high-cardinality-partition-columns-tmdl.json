{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "SEMANTICMODEL_DIRECTLAKE_HIGH_CARDINALITY_PARTITIONS_TMDL",
      "tags": ["semantic-model", "direct-lake", "performance"],
      "name": "Direct Lake Tables Must Not Partition on High-Cardinality Columns (TMDL)",
      "description": "TMDL variant of rule 35. Returns the table .tmdl file name when a column/partition is annotated 'highCardinality = true'. Remove high-cardinality columns from Direct Lake partition keys. WARNING: This rule was AI-generated and tested only against sample fixtures. Review before production use.",
      "itemType": "SemanticModel",
      "part": "tables:.*\\.tmdl$",
      "test": [
        {
          "let": [
            {
              "pathInfo": { "partinfo": "" },
              "matches": {
                "filetextsearchcount": [
                  {
                    "query": [
                      { "partinfo": "" },
                      { "var": "filesystempath" }
                    ]
                  },
                  "(?i)annotation\\s+highCardinality\\s*=\\s*true"
                ]
              }
            },
            {
              "if": [
                { ">": [ { "var": "matches" }, 0 ] },
                [ { "var": "pathInfo.filesystemname" } ],
                []
              ]
            }
          ]
        },
        []
      ]
    }
  ]
}
