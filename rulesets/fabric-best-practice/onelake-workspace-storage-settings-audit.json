{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "API_ONELAKE_WORKSPACE_STORAGE_SETTINGS_AUDIT",
      "tags": ["onelake", "governance", "configuration"],
      "name": "OneLake Workspace Storage Settings Audit",
      "description": "Calls OneLake settings and returns missing expected top-level properties. WARNING: This rule was AI-generated and tested only against sample fixtures. Review before production use.",
      "itemType": "none",
      "test": [
        {
          "let": [
            {
              "settings": {
                "apiget": [
                  "https://api.fabric.microsoft.com/v1/workspaces/{context-fabricworkspace}/onelake/settings"
                ]
              }
            },
            {
              "diff": [
                ["diagnostics", "lifecycle"],
                {
                  "keys": [
                    {
                      "var": "settings"
                    }
                  ]
                }
              ]
            }
          ]
        },
        []
      ]
    }
  ]
}
