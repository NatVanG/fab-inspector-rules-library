{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "COPYJOB_STAGING_UNEXPECTEDLY_ENABLED",
      "tags": ["data-pipeline", "performance", "configuration"],
      "name": "CopyJob Staging Unexpectedly Enabled",
      "description": "Returns activity names where enableStaging is true. WARNING: This rule was AI-generated and tested only against sample fixtures. Review before production use.",
      "itemType": "CopyJob",
      "part": "copyjob-content.json",
      "test": [
        {
          "map": [
            {
              "filter": [
                {
                  "var": "activities"
                },
                {
                  "==": [
                    {
                      "var": "properties.enableStaging"
                    },
                    true
                  ]
                }
              ]
            },
            {
              "var": "id"
            }
          ]
        },
        []
      ]
    }
  ]
}
