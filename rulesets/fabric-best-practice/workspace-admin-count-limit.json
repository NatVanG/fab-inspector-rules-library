{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "API_WORKSPACE_ADMIN_COUNT_LIMIT",
      "tags": ["security", "access-control", "workspace"],
      "name": "Workspace Administrator Count Must Be Limited",
      "description": "Returns administrator display names when more than three Admin assignments exist. Adjust the threshold to organizational policy and remove unnecessary administrators.",
      "itemType": "none",
      "test": [
        {
          "let": [
            {
              "response": {
                "apiget": [
                  "https://api.fabric.microsoft.com/v1/workspaces/{context-fabricworkspace}/roleAssignments"
                ]
              },
              "assignments": {
                "query": [ { "var": "response" }, { "path": "$.value[*]" } ]
              },
              "admins": {
                "filter": [ { "var": "assignments" }, { "==": [ { "var": "role" }, "Admin" ] } ]
              }
            },
            {
              "if": [
                { ">": [ { "count": [ { "var": "admins" } ] }, 3 ] },
                { "map": [ { "var": "admins" }, { "var": "principal.displayName" } ] },
                []
              ]
            }
          ]
        },
        []
      ]
    }
  ]
}