{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "name": "ForEach Unconstrained Batch Count",
  "description": "Returns ForEach activity names where isSequential=false and batchCount is missing or > 50.",
  "rules": [
    {
      "id": "DP_FOREACH_UNCONSTRAINED_BATCHCOUNT",
      "tags": ["data-pipeline", "performance", "configuration"],
      "name": "ForEach Unconstrained Batch Count",
      "description": "Returns ForEach activity names where isSequential=false and batchCount is missing or > 50. WARNING: This rule was AI-generated and tested only against sample fixtures. Review before production use.",
      "itemType": "DataPipeline",
      "part": "pipeline-content.json",
      "test": [
        {
          "map": [
            {
              "filter": [
                { "path": "$.properties.activities[*]" },
                {
                  "and": [
                    { "==": [ { "var": "type" }, "ForEach" ] },
                    { "==": [ { "var": "typeProperties.isSequential" }, false ] },
                    {
                      "or": [
                        { "isnullorempty": [ { "var": "typeProperties.batchCount" } ] },
                        { ">": [ { "var": "typeProperties.batchCount" }, 50 ] }
                      ]
                    }
                  ]
                }
              ]
            },
            { "var": "name" }
          ]
        },
        []
      ]
    }
  ]
}
