{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "API_INBOUND_PUBLIC_ACCESS_MUST_BE_DENIED",
      "tags": ["security", "networking", "access-control"],
      "name": "Inbound Public Access Must Be Denied",
      "description": "Returns a marker if inbound.publicAccessRules.defaultAction is not Deny. WARNING: This rule was AI-generated and tested only against sample fixtures. Review before production use.",
      "itemType": "none",
      "test": [
        {
          "if": [
            {
              "!=": [
                {
                  "query": [
                    {
                      "apiget": [
                        "https://api.fabric.microsoft.com/v1/workspaces/{context-fabricworkspace}/networking/communicationPolicy"
                      ]
                    },
                    {
                      "var": "inbound.publicAccessRules.defaultAction"
                    }
                  ]
                },
                "Deny"
              ]
            },
            ["INBOUND_DEFAULT_NOT_DENY"],
            []
          ]
        },
        []
      ]
    }
  ]
}
