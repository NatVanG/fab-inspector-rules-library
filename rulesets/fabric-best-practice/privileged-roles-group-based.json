{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "API_PRIVILEGED_ROLES_GROUP_BASED",
      "tags": ["security", "access-control", "identity"],
      "name": "Privileged Workspace Roles Should Be Group Based",
      "description": "Returns individual users assigned Admin, Member, or Contributor. Replace direct user assignments with governed Microsoft Entra groups unless an approved exception exists.",
      "itemType": "none",
      "test": [
        {
          "let": [
            {
              "response": {
                "apiget": [
                  "https://api.fabric.microsoft.com/v1/workspaces/{context-fabricworkspace}/roleAssignments"
                ]
              },
              "assignments": {
                "query": [ { "var": "response" }, { "path": "$.value[*]" } ]
              }
            },
            {
              "map": [
                {
                  "filter": [
                    { "var": "assignments" },
                    {
                      "and": [
                        { "==": [ { "var": "principal.type" }, "User" ] },
                        { "in": [ { "var": "role" }, [ "Admin", "Member", "Contributor" ] ] }
                      ]
                    }
                  ]
                },
                { "var": "principal.displayName" }
              ]
            }
          ]
        },
        []
      ]
    }
  ]
}