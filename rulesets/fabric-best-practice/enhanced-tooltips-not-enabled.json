      "part": "Report",
      "test": [
        {
          "if": [
            {
              "==": [
                {
                  "var": "settings.useEnhancedTooltips"
                },
                true
              ]
            },
            [],
            [
              {
                "torecord": [
                  "useEnhancedTooltips",
                  {
                    "var": "settings.useEnhancedTooltips"
                  }
                ]
              }
            ]
          ]
        },
        []
      ]
    }
  ]
