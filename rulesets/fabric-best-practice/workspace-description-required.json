{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "API_WORKSPACE_DESCRIPTION_REQUIRED",
      "tags": ["workspace", "documentation", "governance"],
      "name": "Workspace Description Required",
      "description": "Returns the workspace display name when its description is empty. Add a description that states the workspace purpose, owner, and intended data products.",
      "itemType": "none",
      "test": [
        {
          "let": [
            {
              "workspace": {
                "apiget": [
                  "https://api.fabric.microsoft.com/v1/workspaces/{context-fabricworkspace}"
                ]
              }
            },
            {
              "if": [
                { "isnullorempty": [ { "var": "workspace.description" } ] },
                [ { "var": "workspace.displayName" } ],
                []
              ]
            }
          ]
        },
        []
      ]
    }
  ]
}