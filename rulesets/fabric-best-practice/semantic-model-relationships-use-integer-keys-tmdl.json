{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "SEMANTICMODEL_RELATIONSHIPS_USE_INTEGER_KEYS_TMDL",
      "name": "Semantic Model Must Use Integer Keys in Relationships (TMDL)",
      "description": "TMDL variant of rule 36. Returns definition/relationships.tmdl when a relationship is annotated 'keyType = string'. Prefer integer surrogate keys for relationships. WARNING: This rule was AI-generated and tested only against sample fixtures. Review before production use.",
      "itemType": "SemanticModel",
      "part": "relationships\\.tmdl$",
      "test": [
        {
          "let": [
            {
              "pathInfo": { "partinfo": "" },
              "matches": {
                "filetextsearchcount": [
                  {
                    "query": [
                      { "partinfo": "" },
                      { "var": "filesystempath" }
                    ]
                  },
                  "(?i)annotation\\s+keyType\\s*=\\s*string"
                ]
              }
            },
            {
              "if": [
                { ">": [ { "var": "matches" }, 0 ] },
                [ { "var": "pathInfo.filesystemname" } ],
                []
              ]
            }
          ]
        },
        []
      ]
    }
  ]
}
