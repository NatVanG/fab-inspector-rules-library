{
  "$schema": "https://raw.githubusercontent.com/NatVanG/fab-inspector-test-harness/f651610a319d09d8710ef0549ab52bb1b32a7dc8/.ai-assets/RuleSchemas/fab-inspector-rules.schema.json",
  "rules": [
    {
      "id": "SEMANTICMODEL_MEASURE_NAMES_TITLE_CASE_TMDL",
      "name": "Semantic Model Measure Names Must Use Title Case Without Underscores (TMDL)",
      "description": "TMDL variant of rule 52. Returns the table .tmdl file name when it declares a measure whose name begins with a lowercase letter or contains an underscore. Rename measures to Title Case (e.g. 'Total Sales'). WARNING: This rule was AI-generated and tested only against sample fixtures. Review before production use.",
      "itemType": "SemanticModel",
      "part": "tables:.*\\.tmdl$",
      "test": [
        {
          "let": [
            {
              "pathInfo": { "partinfo": "" },
              "matches": {
                "filetextsearchcount": [
                  {
                    "query": [
                      { "partinfo": "" },
                      { "var": "filesystempath" }
                    ]
                  },
                  "(?m)^[\\t ]*measure[\\t ]+'?(?:[a-z]|[A-Za-z0-9 ]*_)"
                ]
              }
            },
            {
              "if": [
                { ">": [ { "var": "matches" }, 0 ] },
                [ { "var": "pathInfo.filesystemname" } ],
                []
              ]
            }
          ]
        },
        []
      ]
    }
  ]
}
