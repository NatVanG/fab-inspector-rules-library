{
  "properties": {
    "description": "Calls an external REST endpoint with certificate validation disabled.",
    "activities": [
      {
        "name": "CallExternalApi",
        "type": "WebActivity",
        "typeProperties": {
          "url": "https://api.contoso.com/v1/status",
          "method": "GET",
          "disableCertValidation": true
        }
      },
      {
        "name": "NotifyWebhook",
        "type": "WebHook",
        "typeProperties": {
          "url": "https://hooks.contoso.com/notify",
          "method": "POST"
        }
      }
    ]
  }
}
