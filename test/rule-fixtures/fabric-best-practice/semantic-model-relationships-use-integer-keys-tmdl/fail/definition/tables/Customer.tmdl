table Customer

	column CustomerKey
		dataType: int64
		summarizeBy: none
		sourceColumn: CustomerKey

	column CustomerCode
		dataType: string
		summarizeBy: none
		sourceColumn: CustomerCode

	column 'Customer Name'
		dataType: string
		summarizeBy: none
		sourceColumn: CustomerName

	partition Customer = m
		mode: import
		source =
				let
					Source = Sql.Database("server", "db"),
					Customer = Source{[Schema="dbo", Item="Customer"]}[Data]
				in
					Customer
